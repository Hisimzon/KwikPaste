* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
*.svg text eol=lf

*.png binary
*.ico binary
*.icns binary
*.wav binary
*.kwikpastebak binary

# *.sql 故意不设 eol：已发布版本在 Windows 存 CRLF 校验和、在 macOS 存 LF，任何 eol/-text 规则都会让存量用户启动失败。
# third_party 保持与 crates.io 原样字节一致（放在最后，覆盖上面的 eol=lf）。
third_party/** -text
