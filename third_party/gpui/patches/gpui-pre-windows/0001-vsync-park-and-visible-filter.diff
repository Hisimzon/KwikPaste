+/// Wake the vsync thread, e.g. because a window became visible.
+pub(crate) fn wake_vsync_thread() {
+    let (flag, condvar) = &*VSYNC_WAKE;
+    *flag.lock().unwrap() = true;
+    condvar.notify_all();
