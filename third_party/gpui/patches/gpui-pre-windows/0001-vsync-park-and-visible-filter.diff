+        VSYNC_THREAD_ALIVE.store(true, std::sync::atomic::Ordering::Release);
+        Self
+    }
+}
+
+impl Drop for VSyncThreadAlive {
+    fn drop(&mut self) {
+        VSYNC_THREAD_ALIVE.store(false, std::sync::atomic::Ordering::Release);
+    }
+}
